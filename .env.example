# Copy to `.env` and fill in.
#
# Postgres, provisioned via Vercel's Supabase integration — the same database is used for
# both local dev and production (there is no separate local database). Get both values from
# the Supabase dashboard: project -> "Connect" button -> "Prisma" -> copy both connection
# strings shown there. Do NOT try to copy these from Vercel's env var settings — the Supabase
# integration marks them "Sensitive" there, which makes them write-only (unreadable) in
# Vercel's own dashboard once saved.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Admin accounts seeded by prisma/seed.ts.
# Set real values in .env (gitignored). Passwords are bcrypt-hashed at seed time and are
# never stored, logged or committed in plaintext.
ADMIN_1_EMAIL="owner@example.com"
ADMIN_1_NAME="Owner Name"
ADMIN_1_PASSWORD="change-me-at-least-10-chars"
ADMIN_1_ROLE="OWNER"

ADMIN_2_EMAIL="staff@example.com"
ADMIN_2_NAME="Staff Name"
ADMIN_2_PASSWORD="change-me-at-least-10-chars"
ADMIN_2_ROLE="STAFF"

# Email (Resend) — lib/email.ts falls back to its existing console.info stub behaviour for
# any function whose required vars below are missing, so leaving these unset is safe.
# TODO(LAAL): sign up at resend.com, verify a sending domain, paste the API key here.
# RESEND_API_KEY=""
# TODO(LAAL): must be an address on a domain verified with Resend.
# EMAIL_FROM="LAAL <orders@laalcosmetics.com>"
# TODO(LAAL): where order/contact/stockist notifications should be sent — LAAL has not
# supplied a receiving email address yet, CONTACT_EMAIL in lib/config.ts is still null too.
# ADMIN_NOTIFICATION_EMAIL=""

# Cloudflare R2 (S3-compatible object storage) — lib/uploads.ts falls back to local-disk
# storage when these are unset, exactly as it does today.
# TODO(LAAL): create a Cloudflare account and an R2 bucket, then fill these in.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# TODO(LAAL): the public base URL the bucket (or its custom domain) serves objects from,
# e.g. "https://pub-xxxxxxxx.r2.dev" or a custom domain fronting the bucket.
# R2_PUBLIC_BASE_URL=""

# Analytics — app/layout.tsx renders nothing extra when these are unset. Both need the
# NEXT_PUBLIC_ prefix because they are read client-side.
# TODO(LAAL): GA4 measurement ID (Google Analytics 4 property), e.g. "G-XXXXXXXXXX".
# NEXT_PUBLIC_GA4_ID=""
# TODO(LAAL): Meta (Facebook) Pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=""
